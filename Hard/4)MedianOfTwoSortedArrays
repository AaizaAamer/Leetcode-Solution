class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        nums=[]
        nums=nums1+nums2
        for num in range(1,len(nums)):
            temp=num
            while temp>0:
                if nums[temp]>nums[temp-1]:
                    break
                if nums[temp]<nums[temp-1]:
                    temp1=nums[temp-1]
                    nums[temp-1]=nums[temp]
                    nums[temp]=temp1
                    temp=temp-1
       
        if len(nums) % 2 == 1:
            median = nums[len(nums) // 2]
        else:
            medianVal1 = nums[len(nums) // 2 - 1]
            medianVal2 = nums[len(nums) // 2]

            median = (medianVal1 + medianVal2) / 2.0

        return median
